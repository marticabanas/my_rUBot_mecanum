<?xml version="1.0"?>
<launch>
    <arg name="distance_limit" default="0.3"/>
    <arg name="speed_factor"   default="1.0"/>
    <arg name="forward_speed"  default="0.2"/>
    <arg name="lateral_speed"  default="0.2"/>
    <arg name="time_to_stop"   default="30.0"/>
    
    <node
        pkg="my_robot_control" exec="my_robot_selfcontrol_holonomic_exec" name="robot_selfcontrol_holonomic_node" output="screen">
            <param name="distance_limit" value="$(var distance_limit)"/>
            <param name="speed_factor"   value="$(var speed_factor)"/>
            <param name="forward_speed"  value="$(var forward_speed)"/>
            <param name="lateral_speed"  value="$(var lateral_speed)"/>
            <param name="time_to_stop"   value="$(var time_to_stop)"/>
    </node>
</launch>
